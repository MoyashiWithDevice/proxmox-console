# Proxmox Console 統合設定ファイル
# 使い方:
#   cp .env.example .env
#   ./scripts/render-config.sh
#   docker compose up

# 公開URL / ポート
APP_URL=http://localhost:8080
KRATOS_BROWSER_URL=http://localhost:4433
KRATOS_UI_URL=http://localhost:3000

# Kratos self-service UI
COOKIE_SECRET=changeme-cookie-secret-32ch
CSRF_COOKIE_NAME=ory_kratos_csrf
CSRF_COOKIE_SECRET=changeme-csrf-secret-32ch

# Internal Address, to connect Kratos and this app
KRATOS_PUBLIC_URL=http://kratos:4433

# Kratos DB
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=secret
KRATOS_DB_NAME=kratos
KRATOS_DSN=postgres://kratos:secret@kratos-postgres:5432/kratos?sslmode=disable&max_conns=20&max_idle_conns=4

# アプリDB
DB_USER=pguser
DB_PASSWORD=secret
DB_NAME=app

# Proxmox VE API設定 (Go・Terraform 両方で共通利用)
PROXMOX_VE_ENDPOINT=https://192.168.0.100:8006/
PROXMOX_VE_USERNAME=user@pam
PROXMOX_VE_PASSWORD=
PROXMOX_VE_API_TOKEN=

# Terraform 追加変数
TF_VAR_proxmox_insecure=true
TF_VAR_node_name=pve