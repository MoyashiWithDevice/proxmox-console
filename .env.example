# Proxmox Console 統合設定ファイル
# 使い方:
#   cp .env.example .env
#   ./scripts/render-config.sh
#   docker compose up

# 公開URL / ポート
APP_URL=http://localhost:8080
PORT=8080
KRATOS_BROWSER_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434
KRATOS_UI_URL=http://localhost:3000

# GoアプリからKratosへアクセスするURL
# Docker外でGoアプリを起動する場合: http://localhost:4433
# Docker Compose内のサービスから起動する場合: http://kratos:4433
KRATOS_API_URL=http://localhost:4433

# Kratos self-service UI
COOKIE_SECRET=changeme-cookie-secret-32ch
CSRF_COOKIE_NAME=ory_kratos_csrf
CSRF_COOKIE_SECRET=changeme-csrf-secret-32ch
KRATOS_PUBLIC_URL=http://kratos:4433

# Kratos DB
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=secret
KRATOS_DB_NAME=kratos
KRATOS_DSN=postgres://kratos:secret@kratos-postgres:5432/kratos?sslmode=disable&max_conns=20&max_idle_conns=4

# アプリDB
DB_HOST=app-postgres
DB_PORT=5432
DB_USER=u22
DB_PASSWORD=secret
DB_NAME=app

# Proxmox VE API設定 (Go・Terraform 両方で共通利用)
TF_VAR_proxmox_api_url=https://192.168.1.100:8006/api2/json
TF_VAR_proxmox_username=user@pam
TF_VAR_proxmox_password=secret
TF_VAR_proxmox_api_token_id=
TF_VAR_proxmox_api_token_secret=
TF_VAR_proxmox_insecure=true

# Terraform 追加変数
TF_VAR_proxmox_endpoint=https://192.168.1.100:8006/
TF_VAR_node_name=pve
