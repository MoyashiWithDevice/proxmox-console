# このファイルはテンプレートです。
# ルート直下の .env を編集してから ./scripts/render-config.sh を実行すると、
# kratos/kratos.yaml が生成されます。

dsn: ${KRATOS_DSN}

serve:
  public:
    base_url: ${KRATOS_BROWSER_URL}

selfservice:
  default_browser_return_url: ${APP_URL}
  allowed_return_urls:
    - ${APP_URL}
  methods:
    password:
      enabled: true

  flows:
    login:
      ui_url: ${KRATOS_UI_URL}/login
    registration:
      ui_url: ${KRATOS_UI_URL}/registration
    error:
      ui_url: ${KRATOS_UI_URL}/error
identity:
  schemas:
    - id: default
      url: file:///etc/config/identity.schema.json
